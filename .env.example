# --- LLM providers ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=

# Default models
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-5

# Which provider each role uses by default (openai | anthropic)
SUPERVISOR_PROVIDER=openai
SPECIALIST_PROVIDER=openai
REVIEWER_PROVIDER=openai

# --- Datastores (filled in from milestone 2 onward) ---
DATABASE_URL=postgresql+psycopg://orchestrator:orchestrator@localhost:5433/orchestrator
REDIS_URL=redis://localhost:6379/0
CHROMA_HOST=localhost
CHROMA_PORT=8001

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
